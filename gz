#!/bin/bash
# --------------------- 00-lib.sh ---------------------
# Shared logging, colors, and command-checking helpers used by every
# subcommand. Ported from the common header duplicated across all of
# references/old-script/*.sh.

GZ_VERSION="0.1.2_202611041432"

if [ -t 2 ]; then
  ESC=$(printf '\033')

  W="${ESC}[0;39m"
  R="${ESC}[1;31m"
  G="${ESC}[1;32m"
  Y="${ESC}[1;33m"
  B="${ESC}[1;34m"
  DIM="${ESC}[2m"
  C0="${ESC}[0m"
else
  W=
  R=
  G=
  Y=
  B=
  DIM=
  C0=
fi

log_format() {
  local _level=$1
  shift

  local _ts _msg _print _fd
  _ts=$(date '+%Y-%m-%d %H:%M:%S %z')
  _msg="$_ts - $_level : $*"

  case $_level in
    INFO)
      _print=$_msg
      _fd=1
      ;;
    WARN)
      _print="$_ts - ${Y}WARN${C0} : $*"
      _fd=2
      ;;
    ERROR)
      _print="$_ts - ${R}ERROR${C0} : $*"
      _fd=2
      ;;
    *)
      _print=$_msg
      _fd=1
      ;;
  esac

  printf '%b\n' "$_print" >&"$_fd"
}

log() {
  log_format INFO "$@"
}

log_warn() {
  log_format WARN "$@"
}

log_error() {
  log_format ERROR "$@"
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    log_error "Required command not found: $1"
    exit 1
  fi
}

require_cmd_list() {
  local cmd
  for cmd in "$@"; do
    require_cmd "$cmd"
  done
}

# confirm PROMPT [DEFAULT] — DEFAULT is "y" (default) or "n". Honors the
# subcommand-local $SKIP_PROMPT (set by -y) to bypass the prompt entirely.
confirm() {
  local _prompt=$1
  local _default=${2:-y}

  if [ "${SKIP_PROMPT:-false}" = "true" ]; then
    return 0
  fi

  if [ "$_default" = "n" ]; then
    printf "%s (y/N): " "$_prompt"
  else
    printf "%s (Y/n): " "$_prompt"
  fi

  local _answer
  read -r _answer

  if [ "$_default" = "n" ]; then
    case "$_answer" in
      y|Y) return 0 ;;
      *) return 1 ;;
    esac
  else
    case "$_answer" in
      n|N) return 1 ;;
      *) return 0 ;;
    esac
  fi
}

check_git_identity() {
  local _name _email
  _name="$(git config user.name)"
  _email="$(git config user.email)"

  if [ -z "$_name" ] || [ -z "$_email" ]; then
    log_error "Git user.name and user.email must be configured before committing"
    log_error "Run: git config --global user.name \"Your Name\""
    log_error "Run: git config --global user.email \"you@example.com\""
    exit 1
  fi
}

# push_remote REF [--force] — pushes REF (branch or tag) to origin if it's
# configured and reachable; warns (never fails the caller) otherwise.
push_remote() {
  local _ref=$1
  local _force=${2:-}

  if ! git remote get-url origin >/dev/null 2>&1; then
    log "No origin remote found, skipping push"
    return 0
  fi

  log "Checking origin remote access"

  if ! git ls-remote origin >/dev/null 2>&1; then
    log_warn "Origin remote is not accessible"
    log_warn "Fix credentials or remote access, then push manually:"
    log_warn "git push ${_force:+--force }origin $_ref"
    return 0
  fi

  log "Pushing '$_ref' to origin"

  if ! git push ${_force:+--force} origin "$_ref"; then
    log_warn "Push failed"
    log_warn "Fix credentials or remote access, then run:"
    log_warn "git push ${_force:+--force }origin $_ref"
  fi
}
#!/bin/bash
# --------------------- init.sh ---------------------
# `gz init` — lightweight, non-destructive repo bootstrap.
# Ported from references/old-script/git-init.sh.

GZ_INIT_GITIGNORE_ENTRIES='.*/
!.gitignore
.env
*.code-workspace'

cmd_init_usage() {
  printf '%s\n' "Usage: gz init"
  printf '\n'
  printf '%s\n' "Initializes a git repository in the current directory (if one doesn't"
  printf '%s\n' "already exist), renames the branch to 'main', and ensures .gitignore"
  printf '%s\n' "has the standard entries at the top. Makes no commit and no push."
}

cmd_init() {
  for _arg in "$@"; do
    case "$_arg" in
      --help|-h)
        cmd_init_usage
        return 0
        ;;
      *)
        log_error "Unknown option: $_arg"
        cmd_init_usage
        return 1
        ;;
    esac
  done

  require_cmd git

  if [ ! -d .git ]; then
    log "Initializing git repository"
    git init .
    log "Renaming branch to main"
    git branch -m main
  else
    log "Git repository already initialized, skipping git init"
  fi

  if [ -f .gitignore ]; then
    log "Adding default entries to top of existing .gitignore"
    local _tmp
    _tmp=$(mktemp)
    printf '%s\n' "$GZ_INIT_GITIGNORE_ENTRIES" >"$_tmp"
    cat .gitignore >>"$_tmp"
    mv "$_tmp" .gitignore
  else
    log "Creating .gitignore"
    printf '%s\n' "$GZ_INIT_GITIGNORE_ENTRIES" >.gitignore
  fi

  log "Done"
}
#!/bin/bash
# --------------------- merge.sh ---------------------
# `gz merge` — destructive history squash: collapses the entire repo
# history into a single fresh commit. Ported from
# references/old-script/git-merge.sh.

cmd_merge_usage() {
  printf '%s\n' "Usage: gz merge [-y] [COMMIT_MESSAGE]"
  printf '\n'
  printf '%s\n' "  -y    skip confirmation prompt"
  printf '\n'
  printf '%s\n' "WARNING: this deletes all git history. Resets the repo to a single"
  printf '%s\n' "fresh commit (default message: \"Initial commit\"), force-moves the"
  printf '%s\n' "'latest' tag to it, then force-pushes main and 'latest' to origin"
  printf '%s\n' "(skipped silently if no remote)."
}

cmd_merge() {
  require_cmd git

  SKIP_PROMPT=false
  local _args=()
  local _arg
  for _arg in "$@"; do
    case "$_arg" in
      --help|-h)
        cmd_merge_usage
        return 0
        ;;
      -y)
        SKIP_PROMPT=true
        ;;
      -*)
        log_error "Unknown option: $_arg"
        cmd_merge_usage
        return 1
        ;;
      *)
        _args+=("$_arg")
        ;;
    esac
  done

  local _commit_message=${_args[0]:-Initial commit}

  check_git_identity

  if [ ! -d .git ]; then
    log "Initializing new git repository"
    git init -b main
  else
    if ! confirm "${Y}WARNING: this will delete all git history. Continue?${C0}" n; then
      log "Operation cancelled"
      return 0
    fi

    log "Creating temporary orphan branch"
    git checkout --orphan merge-reset-temp

    log "Removing old tracked files"
    git rm -rf --cached . >/dev/null 2>&1 || true

    log "Removing old branch history"
    git branch -D main >/dev/null 2>&1 || true

    log "Renaming temporary branch to main"
    git branch -M main
  fi

  log "Adding all current files"
  git add -A

  if git diff --cached --quiet; then
    log_warn "Nothing to commit"
    return 0
  fi

  log "Creating initial commit"
  git commit -m "$_commit_message"
  git branch -M main

  log "Tagging latest commit as 'latest'"
  git tag -f latest

  push_remote main --force
  push_remote latest --force

  log "Done"
}
#!/bin/bash
# --------------------- submodule.sh ---------------------
# `gz submodule` — manage git submodules in the current repo. Ported from
# references/old-script/submodule.sh.

cmd_submodule_usage() {
  printf '%s\n' "Usage: gz submodule <action> [args]"
  printf '\n'
  printf '%s\n' "  add <url> <path> [branch]   Add a new submodule."
  printf '%s\n' "  list                         List all submodules with their pegged version."
  printf '%s\n' "  rm <path>                    Remove a submodule (prompts for confirmation)."
  printf '%s\n' "  tags <path> [N]              List the N most recent tags for a submodule (default 20)."
  printf '%s\n' "  checkout <path> <ref>        Fetch and check out a tag/branch/commit in a submodule."
}

_submodule_require() {
  local _path=$1
  if [ ! -d "$_path" ]; then
    log_error "No such path: $_path"
    return 1
  fi
  if [ ! -d "$_path/.git" ] && [ ! -f "$_path/.git" ]; then
    log_error "$_path is not an initialized submodule. Run: git submodule update --init $_path"
    return 1
  fi
}

_submodule_pegged_version() {
  local _path=$1
  git -C "$_path" describe --tags --long 2>/dev/null \
    || git -C "$_path" rev-parse --short HEAD
}

_submodule_add() {
  local _url=${1:-} _path=${2:-} _branch=${3:-}
  if [ -z "$_url" ] || [ -z "$_path" ]; then
    log_error "Usage: gz submodule add <url> <path> [branch]"
    return 1
  fi
  if [ -n "$_branch" ]; then
    git submodule add -b "$_branch" "$_url" "$_path"
  else
    git submodule add "$_url" "$_path"
  fi
  printf '\n'
  printf '%s\n' "Added. Review and commit .gitmodules + $_path to finish:"
  printf '%s\n' "  git add .gitmodules $_path && git commit"
}

_submodule_list() {
  if [ ! -f .gitmodules ]; then
    printf '%s\n' "No submodules configured."
    return 0
  fi
  git submodule foreach --quiet '
    ref=$(git describe --tags --long 2>/dev/null || git rev-parse --short HEAD)
    url=$(git config --get remote.origin.url)
    printf "%-20s %-35s %s\n" "$sm_path" "$ref" "$url"
  '
}

_submodule_rm() {
  local _path=${1:-}
  if [ -z "$_path" ]; then
    log_error "Usage: gz submodule rm <path>"
    return 1
  fi
  _submodule_require "$_path" || return 1

  if ! confirm "This will deinit and remove the submodule at '$_path' (currently: $(_submodule_pegged_version "$_path")). Proceed?" n; then
    log "Operation cancelled"
    return 0
  fi

  git submodule deinit -f -- "$_path"
  git rm -f "$_path"
  rm -rf ".git/modules/$_path"

  printf '\n'
  printf '%s\n' "Removed. Review and commit .gitmodules to finish:"
  printf '%s\n' "  git commit -m 'Remove $_path submodule'"
}

_submodule_tags() {
  local _path=${1:-} _count=${2:-20}
  if [ -z "$_path" ]; then
    log_error "Usage: gz submodule tags <path> [N]"
    return 1
  fi
  _submodule_require "$_path" || return 1
  git -C "$_path" fetch --tags --quiet
  git -C "$_path" tag --sort=-creatordate | head -n "$_count"
}

_submodule_checkout() {
  local _path=${1:-} _ref=${2:-}
  if [ -z "$_path" ] || [ -z "$_ref" ]; then
    log_error "Usage: gz submodule checkout <path> <tag|branch|commit>"
    return 1
  fi
  _submodule_require "$_path" || return 1
  git -C "$_path" fetch --all --tags --quiet
  git -C "$_path" checkout "$_ref"
  printf '\n'
  printf '%s\n' "$_path is now at: $(_submodule_pegged_version "$_path")"
  printf '\n'
  printf '%s\n' "Note: this moves the submodule's checked-out commit locally only. Run" \
                "'git add $_path && git commit' in this repo to record the new" \
                "submodule pointer, if that's what you want."
}

cmd_submodule() {
  require_cmd git

  local _action=${1:-}
  case "$_action" in
    --help|-h|"")
      cmd_submodule_usage
      return 0
      ;;
  esac
  shift

  case "$_action" in
    add) _submodule_add "$@" ;;
    list) _submodule_list "$@" ;;
    rm) _submodule_rm "$@" ;;
    tags) _submodule_tags "$@" ;;
    checkout) _submodule_checkout "$@" ;;
    *)
      log_error "Unknown action: $_action"
      cmd_submodule_usage
      return 1
      ;;
  esac
}
#!/bin/bash
# --------------------- tag.sh ---------------------
# `gz tag` — create/move a tag and push it. Ported from
# references/old-script/git-tag-update.sh.

cmd_tag_usage() {
  printf '%s\n' "Usage: gz tag [-y] TAG [MESSAGE]"
  printf '\n'
  printf '%s\n' "  -y    skip confirmation prompt"
  printf '\n'
  printf '%s\n' "Deletes any existing local tag named TAG, then recreates it — annotated"
  printf '%s\n' "(-a -m MESSAGE) if MESSAGE is given, lightweight otherwise — and"
  printf '%s\n' "force-pushes it to origin (skipped silently if no remote)."
}

cmd_tag() {
  require_cmd git

  SKIP_PROMPT=false
  local _args=()
  local _arg
  for _arg in "$@"; do
    case "$_arg" in
      --help|-h)
        cmd_tag_usage
        return 0
        ;;
      -y)
        SKIP_PROMPT=true
        ;;
      -*)
        log_error "Unknown option: $_arg"
        cmd_tag_usage
        return 1
        ;;
      *)
        _args+=("$_arg")
        ;;
    esac
  done

  local _tag=${_args[0]:-}
  local _tag_message=${_args[1]:-}

  if [ -z "$_tag" ]; then
    log_error "Missing required argument: TAG"
    cmd_tag_usage
    return 1
  fi

  if ! confirm "Create tag '$_tag'?"; then
    log "Operation cancelled"
    return 0
  fi

  git tag -d "$_tag" >/dev/null 2>&1 || true

  if [ -n "$_tag_message" ]; then
    log "Creating annotated tag '$_tag'"
    git tag -a "$_tag" -m "$_tag_message"
  else
    log "Creating tag '$_tag'"
    git tag "$_tag"
  fi

  push_remote "$_tag" --force

  log "Done"
}
#!/bin/bash
# --------------------- update.sh ---------------------
# `gz update` — the everyday "commit and publish" loop.
# Ported from references/old-script/git-update.sh.

cmd_update_usage() {
  printf '%s\n' "Usage: gz update [-y] [COMMIT_MESSAGE]"
  printf '\n'
  printf '%s\n' "  -y    skip confirmation prompt"
  printf '\n'
  printf '%s\n' "Stages and commits all changes (default message: \"minor update\"),"
  printf '%s\n' "force-moves the 'latest' tag to the new commit, then pushes main and"
  printf '%s\n' "force-pushes 'latest' to origin (skipped silently if no remote)."
}

cmd_update() {
  require_cmd git

  SKIP_PROMPT=false
  local _args=()
  local _arg
  for _arg in "$@"; do
    case "$_arg" in
      --help|-h)
        cmd_update_usage
        return 0
        ;;
      -y)
        SKIP_PROMPT=true
        ;;
      -*)
        log_error "Unknown option: $_arg"
        cmd_update_usage
        return 1
        ;;
      *)
        _args+=("$_arg")
        ;;
    esac
  done

  local _commit_message=${_args[0]:-minor update}

  check_git_identity

  if [ ! -d .git ]; then
    log "Initializing new git repository"
    git init -b main
  fi

  local _changes
  _changes="$(git status --porcelain)"

  if [ -z "$_changes" ]; then
    log_warn "Nothing to commit"
    return 0
  fi

  log "Changed files:"
  git status --short

  if ! confirm "Commit these changes?"; then
    log "Operation cancelled"
    return 0
  fi

  git add -A
  git commit -m "$_commit_message"

  log "Tagging latest commit as 'latest'"
  git tag -f latest

  push_remote main
  push_remote latest --force

  log "Done"
}
#!/bin/bash
# --------------------- 99-main.sh ---------------------
# Top-level argument parsing and subcommand dispatch.

GZ_SUBCOMMANDS="init update merge tag submodule"

print_usage() {
  printf '%s\n' "Usage: gz <subcommand> [options] [args]"
  printf '\n'
  printf '%s\n' "  init         bootstrap a git repo"
  printf '%s\n' "  update       commit, tag 'latest', and push"
  printf '%s\n' "  merge        squash all history into a single fresh commit"
  printf '%s\n' "  tag          create/move a tag and push it"
  printf '%s\n' "  submodule    manage git submodules"
  printf '\n'
  printf '%s\n' "  --help, -h       show this help"
  printf '%s\n' "  --version, -V    show version"
  printf '\n'
  printf '%s\n' "Run 'gz <subcommand> --help' for subcommand-specific options."
}

print_version() {
  printf 'gz %s\n' "$GZ_VERSION"
}

main() {
  if [ "$#" -eq 0 ]; then
    print_usage
    return 1
  fi

  local _subcommand=$1
  shift

  case "$_subcommand" in
    --help|-h)
      print_usage
      return 0
      ;;
    --version|-V)
      print_version
      return 0
      ;;
    init) cmd_init "$@" ;;
    update) cmd_update "$@" ;;
    merge) cmd_merge "$@" ;;
    tag) cmd_tag "$@" ;;
    submodule) cmd_submodule "$@" ;;
    *)
      log_error "Unknown subcommand: $_subcommand"
      print_usage
      return 1
      ;;
  esac
}

main "$@"
